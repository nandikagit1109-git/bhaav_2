# Bhaav environment configuration
# Copy this file to .env and adjust as needed.

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string (required for production)
# For local dev: postgres://bhaav:bhaav@localhost:5432/bhaav
DATABASE_URL=postgres://bhaav:bhaav@localhost:5432/bhaav

# Maximum connections in the pg Pool (default: 30)
# Scale up for high-concurrency deployments; scale down for small instances.
POOL_SIZE=30

# ── Cache ────────────────────────────────────────────────────────
# Redis URL for baseline caching (optional — app runs without it)
# For local dev: redis://localhost:6379
REDIS_URL=

# Baseline cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECS=600

# ── API ──────────────────────────────────────────────────────────
# Anthropic API key — enables AI-written weekly insights.
# Without it, Bhaav falls back to deterministic, metrics-derived copy.
# The key is read server-side only and never shipped to the client.
ANTHROPIC_API_KEY=

# ── Server ───────────────────────────────────────────────────────
# Backend port (default: 8787)
PORT=8787

# Allowed browser origin for CORS (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# ── Privacy & Limits ────────────────────────────────────────────
# Minimum participants required before Campus Pulse serves aggregate data
# (k-anonymity privacy floor; default: 10)
MIN_GROUP_SIZE=10

# Minimum sessions required before a personal baseline is "ready"
# (default: 6)
MIN_BASELINE_SESSIONS=6

# Set to false to skip auto-seeding the demo trajectory on first start
DEMO_SEED=true
