[TEMPLATE]
# Bhaav environment configuration
# Copy this file to .env and adjust as needed.

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string (Neon serverless or local PG)
# Neon:      postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/bhaav?sslmode=require
# Local dev: postgres://bhaav:bhaav@localhost:5432/bhaav
# If omitted, falls back to SQLite (no setup required)
DATABASE_URL=

# Maximum connections in the pg Pool (default: 30, ignored by Neon adapter)
POOL_SIZE=30

# ── Cache ────────────────────────────────────────────────────────
# Redis URL for baseline caching (optional — app runs without it)
# Local dev:  redis://localhost:6379
# Render:     (auto-set from Render Blueprint)
REDIS_URL=

# Baseline cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECS=600

# ── API ──────────────────────────────────────────────────────────
# Anthropic API key — enables AI-written weekly insights.
# Without it, Bhaav falls back to deterministic, metrics-derived copy.
ANTHROPIC_API_KEY=

# ── Server ───────────────────────────────────────────────────────
# Backend port (default: 8787)
# Render sets PORT automatically — do NOT override in production.
PORT=8787

# Allowed browser origin for CORS
# Local dev:  http://localhost:5173
# Production: https://bhaav.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ── Privacy & Limits ────────────────────────────────────────────
MIN_GROUP_SIZE=10
MIN_BASELINE_SESSIONS=5

# Set to false to skip auto-seeding the demo trajectory on first start
DEMO_SEED=true
